      "expected": {"explorer": false, "reviewer": false, "worker": false, "verifier": false, "worktrees": false, "parallel_writers_same_checkout": false, "minimal_history": false, "bounded_output": true, "aggregate_polling": false, "avoid_redundant_rerun": false}
